# Compile-port foundation for the pinned 4.9 tree, NOT a release defconfig.
# Keep legacy board values in the separately hash-verified Lenovo defconfig.
CONFIG_ARCH_QCOM=y
CONFIG_ARCH_MSM8953=y
CONFIG_QCOM_SCM=y
# TB-X704 uses eMMC/SDHCI, not the unrelated UFS controller in the old config.
# CONFIG_SCSI_UFSHCD is not set
# Native Lenovo NT51021 DSI panels do not use the inherited ADV7533 bridge.
# CONFIG_MSM_DBA_ADV7533 is not set
CONFIG_GPIOLIB=y
CONFIG_EXTCON=y
# Pinned MSM8953 reference scheduler partition; runtime topology unvalidated.
CONFIG_NR_CPUS=8
CONFIG_LITTLE_CPU_MASK=240
CONFIG_BIG_CPU_MASK=15
# This downstream fair scheduler calls WALT's mark_reserved unconditionally.
CONFIG_SCHED_WALT=y
# Use the pinned MSM8953 reference's working CFQ group and video driver branch.
CONFIG_BLK_CGROUP=y
CONFIG_CFQ_GROUP_IOSCHED=y
# CONFIG_MSM_VIDC_V4L2 is not set
CONFIG_MSM_VIDC_3X_V4L2=y
CONFIG_MSM_VIDC_3X_GOVERNORS=y
# Retain the downstream legacy camera ABI branch used by old Qualcomm HALs.
CONFIG_MSMB_CAMERA_LEGACY=y
# CONFIG_MACH_XIAOMI is not set
CONFIG_SPMI=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_INPUT_QPNP_POWER_ON=y
CONFIG_QPNP_REVID=y
CONFIG_QPNP_FG=y
CONFIG_QPNP_SMBCHARGER=y
CONFIG_X704_COULOMETER=y
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_DWARF4=y

# Downstream PIL calls mailbox APIs without a local Kconfig dependency.
CONFIG_MAILBOX=y
# Retain Microsoft HID support with its memoryless force-feedback dependency.
CONFIG_INPUT_FF_MEMLESS=y
# Reference MSM8953 syscon support selects hidden REGMAP_MMIO for legacy audio.
CONFIG_MFD_SYSCON=y
